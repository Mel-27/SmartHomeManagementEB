<Window x:Class="SmartHomeManagementEB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartHomeManagementEB"
        mc:Ignorable="d"
        Title="Mel's Smart Home Management" Height="500" Width="820">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Mel's Smart Home Devices" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

        <!-- Input fields -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Device ID" />
                <TextBox x:Name="DeviceIdBox" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Name" />
                <TextBox x:Name="NameBox" />
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Type" />
                <ComboBox x:Name="TypeBox">
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Thermostat" />
                    <ComboBoxItem Content="Lock" />
                    <ComboBoxItem Content="Camera" />
                    <ComboBoxItem Content="Plug" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="3">
                <TextBlock Text="Status" />
                <ComboBox x:Name="StatusBox">
                    <ComboBoxItem Content="On" />
                    <ComboBoxItem Content="Off" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="AddButton" Content="Add Device" Width="110" Margin="0,0,8,0" Click="AddButton_Click" />
            <Button x:Name="UpdateButton" Content="Update Device" Width="110" Margin="0,0,8,0" Click="UpdateButton_Click" />
            <Button x:Name="RemoveButton" Content="Remove Device" Width="110" Margin="0,0,8,0" Click="RemoveButton_Click" />
            <Button x:Name="ClearButton" Content="Clear Fields" Width="100" Click="ClearButton_Click" />
        </StackPanel>

        <!-- Device list -->
        <DataGrid Grid.Row="3" x:Name="DeviceGrid" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="DeviceGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="*" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" x:Name="StatusMessage" Margin="0,8,0,0" Foreground="DarkRed" />
    </Grid>
</Window>